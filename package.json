{
	"name": "gwen-rebuild",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"gwen": "bun run src/cli/index.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun test && eslint . && prettier --check .",
		"check:fast": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun test",
		"review:fingerprint": "bun run scripts/review.ts fingerprint",
		"review:lint": "bun run scripts/review.ts lint",
		"review:check": "bun run scripts/review.ts check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "bun run src/dev/seed.ts",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.2.19",
		"@types/node": "^24",
		"daisyui": "^5.7.7",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@libsql/client": "^0.17.3",
		"drizzle-orm": "^0.45.2",
		"openai": "^7.1.0",
		"zod": "^4.4.3"
	}
}
