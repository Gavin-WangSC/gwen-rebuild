# Drizzle
DATABASE_URL=file:local.db

# DashScope (OpenAI-compatible endpoint) — required for model calls
DASHSCOPE_API_KEY=

# Optional. Defaults to the batch endpoint, which is what GWen v1 used:
#   https://batch.dashscope.aliyuncs.com/compatible-mode/v1
# Latency, cost, and timeout behaviour differ from the standard endpoint —
# set this only to override deliberately (REBUILD.md §5.4).
DASHSCOPE_BASE_URL=
